{
  "name": "@pe-smkk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:local": "wrangler d1 migrations apply pe-smkk-db --local",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pe-smkk/db": "*",
    "@pe-smkk/shared": "*",
    "hono": "^4.7.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wrangler": "^4.4.0"
  }
}
